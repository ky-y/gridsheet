{
    "name": "@ky-y./gridsheet",
    "version": "0.1.0",
    "description": "",
    "keywords": [
        "react",
        "react-component",
        "grid",
        "gridsheet",
        "spreadsheet",
        "table",
        "datagrid",
        "data-grid",
        "editable-table",
        "cell",
        "typescript"
    ],
    "author": {
        "name": "ky-y.",
        "url": "https://ky-y.dev/"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ky-y/gridsheet.git"
    },
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./dist/style.css": "./dist/style.css"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite -c vite.playground.config.ts",
        "build": "tsc --noEmit && vite build",
        "scss:generate": "typed-scss-modules src --exportType default --nameFormat none --allowArbitraryExtensions",
        "scss:watch": "typed-scss-modules src --exportType default --nameFormat none --allowArbitraryExtensions --watch",
        "test": "vitest",
        "format": "biome format --write",
        "format:check": "biome format",
        "lint": "biome lint --write",
        "lint:check": "biome lint",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "changeset": "changeset"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@changesets/changelog-github": "^1.0.1",
        "@changesets/cli": "^3.0.3",
        "@chromatic-com/storybook": "^5.4.0",
        "@microsoft/api-extractor": "^7.59.4",
        "@storybook/addon-a11y": "^10.6.1",
        "@storybook/addon-docs": "^10.6.1",
        "@storybook/addon-onboarding": "^10.6.1",
        "@storybook/addon-vitest": "^10.6.1",
        "@storybook/react-vite": "^10.6.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/browser-playwright": "5.0.3",
        "@vitest/coverage-v8": "5.0.3",
        "jsdom": "^30.1.2",
        "playwright": "^1.64.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "sass": "^1.105.1",
        "storybook": "^10.6.1",
        "typed-scss-modules": "^8.1.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "vite-plugin-dts": "^5.1.2",
        "vitest": "^5.0.3"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "packageManager": "pnpm@10.28.2"
}
